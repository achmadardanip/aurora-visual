# Module 2 (aurora-evidence) optional provider configuration.
# Copy to aurora-evidence/.env.evidence to activate. Keys stay server-side.

# Web search provider (https://docs.tavily.com)
TAVILY_API_KEY=

# AI-text detection (https://gptzero.me/docs)
GPTZERO_API_KEY=

# AI-image detection (Hive V3)
HIVE_API_KEY=

# Data directory for the evidence app (default var-evidence)
AURORA_EVIDENCE_DATA_DIR=var-evidence

# Local corpus JSONL path (default: labeled synthetic demo corpus)
AURORA_EVIDENCE_CORPUS=

# Retrieval budget in seconds
AURORA_EVIDENCE_BUDGET=45
