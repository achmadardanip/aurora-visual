        },
        "validity_notes": {
          "items": {
            "type": "string"
          },
          "title": "Validity Notes",
          "type": "array"
        }
      },
      "required": [
        "status",
        "calibration_id",
        "method",
        "alpha",
        "sample_count",
        "group",
        "fallback_used",
        "validity_notes"
      ],
      "title": "Calibration",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "text": {
