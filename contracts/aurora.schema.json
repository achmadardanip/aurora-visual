{
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "$ref": "#/$defs/RunInfo"
        },
        "atom_set_id": {
          "title": "Atom Set Id",
          "type": "string"
        },
        "atomic_claims": {
          "items": {
            "$ref": "#/$defs/Atom"
          },
          "title": "Atomic Claims",
          "type": "array"
        },
        "visual_assessments": {
          "items": {
            "$ref": "#/$defs/VisualAssessment"
          },
          "title": "Visual Assessments",
          "type": "array"
        },
        "ocr": {
          "items": {
            "$ref": "#/$defs/OCRItem"
          },
          "title": "Ocr",
          "type": "array"
        }
      },
      "required": [
        "run",
        "atom_set_id",
        "atomic_claims",
        "visual_assessments",
        "ocr"
      ],
      "title": "Analysis",
      "type": "object"
    },
    "Atom": {
      "additionalProperties": false,
      "properties": {
        "atom_id": {
          "pattern": "^a[0-9]{6}$",
          "title": "Atom Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "role": {
          "enum": [
            "actor",
            "action",
            "object",
            "attribute",
            "location",
            "time",
            "quantity",
            "relation",
            "cause"
          ],
          "title": "Role",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Object"
        },
        "qualifiers": {
          "$ref": "#/$defs/Qualifiers"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Spans",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "check_worthiness": {
          "maximum": 1,
          "minimum": 0,
          "title": "Check Worthiness",
          "type": "number"
        },
        "parser_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parser Confidence"
        }
      },
      "required": [
        "atom_id",
        "statement",
        "role",
        "subject",
        "predicate",
        "object",
        "qualifiers",
        "spans",
        "depends_on",
        "check_worthiness",
        "parser_confidence"
      ],
      "title": "Atom",
      "type": "object"
    },
    "AtomicDecision": {
      "additionalProperties": false,
      "properties": {
        "atom_id": {
          "title": "Atom Id",
          "type": "string"
        },
        "base_label": {
          "enum": [
            "Supported",
            "Contradicted",
            "InsufficientEvidence"
          ],
          "title": "Base Label",
          "type": "string"
        },
        "status": {
          "enum": [
            "Supported",
            "Contradicted",
            "InsufficientEvidence"
          ],
          "title": "Status",
          "type": "string"
        },
        "probabilities": {
          "anyOf": [
            {
              "additionalProperties": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "propertyNames": {
                "enum": [
                  "Supported",
                  "Contradicted",
                  "InsufficientEvidence"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probabilities"
        },
        "confidence_set": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "Supported",
                  "Contradicted",
                  "InsufficientEvidence"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Set"
        },
        "abstention_flag": {
          "title": "Abstention Flag",
          "type": "boolean"
        },
        "abstention_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Abstention Reasons",
          "type": "array"
        },
        "evidence_links": {
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          },
          "title": "Evidence Links",
          "type": "array"
        },
        "visual_atom_ids": {
          "items": {
            "type": "string"
          },
          "title": "Visual Atom Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "calibration": {
          "$ref": "#/$defs/Calibration"
        }
      },
      "required": [
        "atom_id",
        "base_label",
        "status",
        "probabilities",
        "confidence_set",
        "abstention_flag",
        "abstention_reasons",
        "evidence_links",
        "visual_atom_ids",
        "explanation",
        "calibration"
      ],
      "title": "AtomicDecision",
      "type": "object"
    },
