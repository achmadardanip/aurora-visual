# Module 3 (aurora-decision) configuration.
# Copy to aurora-decision/.env.decision to customize.

# Data directory for the decision app (default var-decision)
AURORA_DECISION_DATA_DIR=var-decision

# Conformal alpha (0.01-0.5); changing it requires a matching calibration artifact
AURORA_DECISION_ALPHA=0.1

# Optional trained fusion head checkpoint (.pt via train-fusion CLI)
AURORA_DECISION_HEAD=

# Upstream service URLs (module 1 and module 2)
AURORA_VISUAL_URL=http://127.0.0.1:8101
AURORA_EVIDENCE_URL=http://127.0.0.1:8102

# Per-job upstream polling deadline in seconds
AURORA_UPSTREAM_DEADLINE=240
