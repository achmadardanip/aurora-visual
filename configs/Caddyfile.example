# Replace with your domain. Keep Compose ports loopback-only and set
# AURORA_PUBLIC=true, AURORA_ALLOWED_HOSTS=aurora.example.org, an exact
# AURORA_CORS origin, and a strong random API token on the server.
aurora.example.org {
    encode zstd gzip
    request_body {
        max_size 40MB
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }
    reverse_proxy 127.0.0.1:5171 {
        header_up X-Forwarded-Proto {scheme}
    }
}
