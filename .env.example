AURORA_DATA_DIR=./var
AURORA_HOST=127.0.0.1
AURORA_PORT=8101
AURORA_FRONTEND_PORT=5171
# Optional server-side Vite proxy target; defaults to local AURORA_PORT.
AURORA_API_INTERNAL_URL=
AURORA_PUBLIC=false
# Required for every API request when AURORA_PUBLIC=true (including media); use 32+ random characters.
AURORA_API_TOKEN=
# Explicit browser origin(s), comma-separated; wildcard is rejected.
AURORA_CORS=http://localhost:5171,http://127.0.0.1:5171
# Explicit HTTP Host values; replace with the deployment domain in public mode.
AURORA_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
AURORA_MAX_UPLOAD_MB=10
AURORA_JOB_TIMEOUT=180
AURORA_MAX_PENDING=20
AURORA_BACKBONE=local-color-v1
# Optional OpenCLIP: server-controlled checkpoint, never a URL from user input.
AURORA_OPENCLIP_MODEL=ViT-B-32
AURORA_OPENCLIP_PRETRAINED=
AURORA_CHECKPOINT=
AURORA_OCR_LANG=ind+eng
# Optional, server-only MAFINDO V1 compatibility diagnostic. Never use VITE_ for this key.
AURORA_MAFINDO_API_KEY=
AURORA_MAFINDO_TIMEOUT_SECONDS=12
# Optional Ollama-compatible structured parser; exact origin must be allowlisted.
AURORA_LLM_URL=
AURORA_LLM_ALLOWED_ORIGINS=http://127.0.0.1:11434
AURORA_LLM_MODEL=
VITE_API_URL=
